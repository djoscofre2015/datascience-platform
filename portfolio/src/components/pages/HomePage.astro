---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';

import {
  getTranslations,
  type Language,
} from '../../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<BaseLayout lang={lang}>
  <Header lang={lang} />

  <main>
    <section id="home" class="hero section">
      <div class="container hero-content">
        <p class="hero-greeting">{t.hero.greeting}</p>

        <h1>{t.hero.title}</h1>

        <p class="hero-description">
          {t.hero.description}
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            {t.hero.projectsButton}
          </a>

          <a class="button button-outline" href="#contact">
            {t.hero.contactButton}
          </a>
        </div>
      </div>
    </section>

    <section id="about" class="section">
      <div class="container">
        <h2 class="section-title">{t.nav.about}</h2>
      </div>
    </section>

    <section id="skills" class="section">
      <div class="container">
        <h2 class="section-title">{t.nav.skills}</h2>
      </div>
    </section>

    <section id="projects" class="section">
      <div class="container">
        <h2 class="section-title">{t.nav.projects}</h2>
      </div>
    </section>

    <section id="certifications" class="section">
      <div class="container">
        <h2 class="section-title">{t.nav.certifications}</h2>
      </div>
    </section>

    <section id="contact" class="section">
      <div class="container">
        <h2 class="section-title">{t.nav.contact}</h2>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 75vh;
    background:
      radial-gradient(
        circle at 75% 30%,
        rgba(56, 189, 248, 0.12),
        transparent 40%
      ),
      var(--color-background);
  }

  .hero-content {
    max-width: 1200px;
  }

  .hero-greeting {
    color: var(--color-primary);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  h1 {
    max-width: 900px;
    margin: 1rem 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hero-description {
    max-width: 650px;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
